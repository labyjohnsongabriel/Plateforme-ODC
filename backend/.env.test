# ============================================================================
#  ODC PLATFORM — Tests (base de données isolée)
# ============================================================================

NODE_ENV=test
PORT=5001
API_PREFIX=/api
CLIENT_URL=http://localhost:5173

# ----------------------------------------------------------------------------
# BASE DE DONNÉES TEST (⚠️ isolée — sera recréée à chaque run)
# ----------------------------------------------------------------------------
DB_CONNECTION=fields
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=Johnson@2026
DB_NAME=odc_db
DB_SCHEMA=public
DB_SSL=false
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_LOGGING=false
DB_SYNCHRONIZE=true     # ⚠️ Uniquement en test
DB_MIGRATIONS_RUN=false
DB_DROP_SCHEMA=true     # ⚠️ Uniquement en test
DB_MIGRATIONS_TABLE=migrations_history

# JWT (test)
JWT_SECRET=$2b$12$pu4941TsqvPPt71z0vrbqO6poWwgIAy2TlfRhn1wRWlFJpeBXjv5u
JWT_REFRESH_SECRET=$2b$12$pu4941TsqvPPt71z0vrbqO6poWwgIAy2TlfRhn1wRWlFJpeBXjv5u
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (désactivé en test)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ODC Test <test@odc.mg>"

# Uploads
UPLOAD_DIR=./uploads-test

# Logs
LOG_LEVEL=error
LOG_DIR=./logs-test
LOG_CONSOLE=false
LOG_FILE=false

# Sécurité
BCRYPT_ROUNDS=4  # Rapide pour tests

# Désactiver les jobs et sockets
CRON_ENABLED=false
REDIS_ENABLED=false