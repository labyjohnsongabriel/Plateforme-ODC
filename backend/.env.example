# ============================================================================
#  ODC PLATFORM — Configuration d'environnement
#  Copier ce fichier vers .env puis remplir les valeurs
#  ⚠️  Ne JAMAIS committer le fichier .env
# ============================================================================

# ----------------------------------------------------------------------------
# APPLICATION
# ----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME="ODC Platform"
APP_VERSION=1.0.0
PORT=5000
API_PREFIX=/api
CLIENT_URL=http://localhost:5173
HOST=0.0.0.0

# ----------------------------------------------------------------------------
# BASE DE DONNÉES POSTGRESQL
# ----------------------------------------------------------------------------
# Type de connexion : url | fields
# - url    : utilise DATABASE_URL (recommandé en production)
# - fields : utilise DB_HOST, DB_PORT, etc.
DB_CONNECTION=fields

# Connexion par URL (prioritaire si DB_CONNECTION=url)
DATABASE_URL=postgresql://odc_user:odc_password@localhost:5432/odc_db

DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=Johnson@2026
DB_NAME=odc_db
DB_SCHEMA=public

# SSL (obligatoire en production)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=

# Pool de connexions (optimisé pour la charge)
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_ACQUIRE_TIMEOUT=60000
DB_STATEMENT_TIMEOUT=30000
DB_QUERY_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# Comportement
DB_LOGGING=false
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true
DB_MIGRATIONS_TABLE=migrations_history
DB_DROP_SCHEMA=false

# Réplication (optionnel — lecture seule)
DB_REPLICA_HOST=
DB_REPLICA_PORT=

# ----------------------------------------------------------------------------
# AUTHENTIFICATION JWT
# ----------------------------------------------------------------------------
JWT_SECRET=$2b$12$pu4941TsqvPPt71z0vrbqO6poWwgIAy2TlfRhn1wRWlFJpeBXjv5u
JWT_REFRESH_SECRET=$2b$12$pu4941TsqvPPt71z0vrbqO6poWwgIAy2TlfRhn1wRWlFJpeBXjv5u
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=odc-platform
JWT_AUDIENCE=odc-client

# ----------------------------------------------------------------------------
# EMAIL SMTP
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@odc.mg
SMTP_PASS=CHANGE_ME_APP_PASSWORD
SMTP_FROM="Orange Digital Center <noreply@odc.mg>"
SMTP_REPLY_TO=contact@odc.mg
SMTP_POOL=true
SMTP_MAX_CONNECTIONS=5
SMTP_MAX_MESSAGES=100

# ----------------------------------------------------------------------------
# UPLOAD FICHIERS
# ----------------------------------------------------------------------------
UPLOAD_DIR=./uploads
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_MAX_FILES=10
UPLOAD_ALLOWED_MIMES=image/jpeg,image/png,image/webp,image/svg+xml,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp,.svg,.pdf,.doc,.docx,.xls,.xlsx
UPLOAD_KEEP_TEMP_HOURS=24

# ----------------------------------------------------------------------------
# CACHE & REDIS (optionnel)
# ----------------------------------------------------------------------------
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=300

# ----------------------------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=20
HEAVY_RATE_LIMIT_MAX=5

# ----------------------------------------------------------------------------
# CORS
# ----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# ----------------------------------------------------------------------------
# LOGS
# ----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_DIR=./logs
LOG_MAX_SIZE=5242880
LOG_MAX_FILES=5
LOG_CONSOLE=true
LOG_FILE=true

# ----------------------------------------------------------------------------
# SÉCURITÉ
# ----------------------------------------------------------------------------
BCRYPT_ROUNDS=12
HELMET_ENABLED=true
TRUST_PROXY=false
REQUEST_TIMEOUT_MS=30000

# ----------------------------------------------------------------------------
# CERTIFICATS & SIGNATURE NUMÉRIQUE
# ----------------------------------------------------------------------------
KEYS_DIR=./keys
ATTESTATION_CRITERIA_PRESENCE_MIN=75
ATTESTATION_CRITERIA_NOTE_MIN=10
ATTESTATION_DELAY_HOURS=24

# ----------------------------------------------------------------------------
# SOCKET.IO
# ----------------------------------------------------------------------------
SOCKET_CORS_ORIGINS=http://localhost:5173
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000
SOCKET_MAX_HTTP_BUFFER_SIZE=1000000

# ----------------------------------------------------------------------------
# JOBS CRON
# ----------------------------------------------------------------------------
CRON_ENABLED=true
CRON_TIMEZONE=Indian/Antananarivo

# ----------------------------------------------------------------------------
# BACKUP
# ----------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
PG_DUMP_PATH=pg_dump

# ----------------------------------------------------------------------------
# SWAGGER
# ----------------------------------------------------------------------------
SWAGGER_ENABLED=true
SWAGGER_PATH=/api-docs

# ----------------------------------------------------------------------------
# MONITORING (optionnel)
# ----------------------------------------------------------------------------
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=