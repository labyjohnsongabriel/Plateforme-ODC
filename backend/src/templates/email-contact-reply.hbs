@'
<!DOCTYPE html>
<html lang="fr">
<head><meta charset="UTF-8"><title>Nous avons bien reçu votre message</title></head>
<body style="margin:0;padding:0;background:#FFF8F2;font-family:'Segoe UI',Arial,sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="padding:30px 15px;">
    <tr>
      <td align="center">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;background:#FFFFFF;border-radius:12px;overflow:hidden;box-shadow:0 4px 12px rgba(255,121,0,0.08);">
          <tr>
            <td bgcolor="#FF7900" style="background:#FF7900;padding:36px 32px;text-align:center;">
              <div style="font-size:48px;line-height:1;margin-bottom:12px;">✅</div>
              <h1 style="color:#FFFFFF;margin:0;font-size:22px;font-weight:700;">Merci {{nom}} !</h1>
              <p style="color:rgba(255,255,255,0.92);margin:8px 0 0;font-size:14px;">Nous avons bien reçu votre message</p>
            </td>
          </tr>
          <tr>
            <td style="padding:32px;">
              <p style="color:#1A1A1A;font-size:15px;line-height:1.7;margin:0 0 16px;">Bonjour <strong>{{nom}}</strong>,</p>
              <p style="color:#4A4A4A;font-size:14px;line-height:1.7;margin:0 0 20px;">
                Nous vous remercions pour votre message concernant
                <strong style="color:#E65100;">« {{sujetLabel}} »</strong>.
                Notre équipe vous répondra sous <strong>24 heures ouvrées</strong>.
              </p>
              <div style="background:#FFF8F2;border-left:4px solid #FF7900;border-radius:8px;padding:18px;margin:24px 0;">
                <p style="margin:0 0 8px;font-size:11px;color:#8A8A8A;text-transform:uppercase;letter-spacing:1.5px;font-weight:600;">Votre message</p>
                <div style="font-size:13px;color:#1A1A1A;line-height:1.6;white-space:pre-wrap;">{{message}}</div>
              </div>
              <p style="color:#6B6B6B;font-size:13px;line-height:1.6;margin:24px 0 0;">
                Si vous avez des informations complémentaires à ajouter, répondez simplement à cet email.
              </p>
              <div style="margin-top:28px;padding-top:24px;border-top:1px solid #F0F0F0;">
                <p style="color:#1A1A1A;font-size:14px;font-weight:600;margin:0 0 8px;">📞 Besoin d'une réponse immédiate ?</p>
                <p style="color:#6B6B6B;font-size:13px;line-height:1.6;margin:0;">
                  <a href="mailto:{{contactEmail}}" style="color:#FF7900;text-decoration:none;font-weight:600;">{{contactEmail}}</a>
                  • Lundi – Vendredi, 8h – 17h
                </p>
              </div>
            </td>
          </tr>
          <tr>
            <td style="background:#FAFAFA;padding:24px 32px;text-align:center;border-top:1px solid #F0F0F0;">
              <p style="color:#FF7900;font-size:13px;font-weight:700;margin:0 0 6px;">{{odcName}}</p>
              <p style="color:#8A8A8A;font-size:11px;margin:0;line-height:1.5;">
                {{odcAdresse}}<br>
                <a href="https://{{odcWebsite}}" style="color:#8A8A8A;text-decoration:none;">{{odcWebsite}}</a>
              </p>
            </td>
          </tr>
        </table>
        <p style="color:#A0A0A0;font-size:11px;margin-top:20px;text-align:center;">© {{year}} {{odcName}}. Tous droits réservés.</p>
      </td>
    </tr>
  </table>
</body>
</html>
'@ | Set-Content -Path "src\templates\email-contact-reply.hbs" -Encoding UTF8